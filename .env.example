VITE_SUPABASE_URL=sua_url_do_supabase
VITE_SUPABASE_ANON_KEY=sua_chave_anon_do_supabase

# Valores de referencia para a Edge Function delete-own-account.
# Nao rode `supabase secrets set --env-file .env.example` com estas variaveis:
# nomes iniciados por SUPABASE_ sao reservados pelo runtime de Edge Functions.
SUPABASE_URL=sua_url_do_supabase
SUPABASE_ANON_KEY=sua_chave_anon_ou_publishable_do_supabase
SUPABASE_SERVICE_ROLE_KEY=sua_chave_service_role_apenas_no_supabase
